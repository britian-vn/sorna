{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores a learner's IELTS pathway level, target band, 4-skill scores, saved placement progress, milestones, earned badges, study streak, and study reminder configuration without storing PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name or alias.",
          "minLength": 1,
          "maxLength": 80
        },
        "currentBandLevel": {
          "type": "string",
          "description": "Active IELTS Band Pathway tier.",
          "enum": ["0-3.5", "3.5-5.0", "5.0-6.0", "6.0-7.0+"],
          "maxLength": 20
        },
        "targetBand": {
          "type": "number",
          "description": "Target IELTS band score from 4.0 to 9.0."
        },
        "diagnosticCompleted": {
          "type": "boolean",
          "description": "Whether the initial diagnostic placement has been completed."
        },
        "diagnosticMode": {
          "type": "string",
          "description": "Selected placement mode (quick or detailed).",
          "enum": ["quick", "detailed", "manual"],
          "maxLength": 20
        },
        "diagnosticStep": {
          "type": "number",
          "description": "Saved step index for resuming an in-progress diagnostic assessment."
        },
        "diagnosticSavedState": {
          "type": "string",
          "description": "Compact serialized state for resuming in-progress placement answers.",
          "maxLength": 4000
        },
        "listeningScore": {
          "type": "number",
          "description": "Estimated IELTS Listening band score (0-9)."
        },
        "readingScore": {
          "type": "number",
          "description": "Estimated IELTS Reading band score (0-9)."
        },
        "writingScore": {
          "type": "number",
          "description": "Estimated IELTS Writing band score (0-9)."
        },
        "speakingScore": {
          "type": "number",
          "description": "Estimated IELTS Speaking band score (0-9)."
        },
        "completedMilestones": {
          "type": "array",
          "description": "Bounded list of completed pathway milestone IDs (max 100)."
        },
        "completedLessons": {
          "type": "array",
          "description": "Bounded list of completed vocabulary and grammar lesson IDs (max 200)."
        },
        "earnedBadges": {
          "type": "array",
          "description": "Bounded list of unlocked Academic Badge IDs (max 50)."
        },
        "studyStreak": {
          "type": "number",
          "description": "Current consecutive days studied."
        },
        "lastStudyDate": {
          "type": "string",
          "description": "YYYY-MM-DD date string of last study activity.",
          "maxLength": 20
        },
        "reminderEnabled": {
          "type": "boolean",
          "description": "Whether daily study reminders are enabled."
        },
        "reminderTime": {
          "type": "string",
          "description": "24-hour HH:MM study reminder time.",
          "maxLength": 10
        },
        "reminderDays": {
          "type": "array",
          "description": "Active days of the week (0-6, max 7 items)."
        },
        "browserPushEnabled": {
          "type": "boolean",
          "description": "Whether browser push notifications are enabled."
        },
        "offlinePackSyncedAt": {
          "type": "string",
          "description": "ISO timestamp of last offline study pack sync.",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last profile update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "currentBandLevel",
        "targetBand",
        "diagnosticCompleted",
        "listeningScore",
        "readingScore",
        "writingScore",
        "speakingScore",
        "completedMilestones",
        "completedLessons",
        "earnedBadges",
        "studyStreak",
        "lastStudyDate",
        "reminderEnabled",
        "reminderTime",
        "reminderDays",
        "browserPushEnabled",
        "updatedAt"
      ]
    },
    "SrsCard": {
      "title": "SrsCard",
      "description": "A vocabulary or grammar flashcard scheduled via the SM-2 Spaced Repetition algorithm.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID of the flashcard.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "word": {
          "type": "string",
          "description": "Headword or phrase.",
          "minLength": 1,
          "maxLength": 120
        },
        "phonetic": {
          "type": "string",
          "description": "IPA phonetic transcription.",
          "maxLength": 120
        },
        "partOfSpeech": {
          "type": "string",
          "description": "Grammatical part of speech.",
          "maxLength": 40
        },
        "definition": {
          "type": "string",
          "description": "Clear English definition.",
          "minLength": 1,
          "maxLength": 600
        },
        "exampleSentence": {
          "type": "string",
          "description": "Contextual academic example sentence.",
          "maxLength": 600
        },
        "topic": {
          "type": "string",
          "description": "IELTS topic category.",
          "maxLength": 60
        },
        "cefrLevel": {
          "type": "string",
          "description": "CEFR level from A1 to C1.",
          "enum": ["A1", "A2", "B1", "B2", "C1"],
          "maxLength": 10
        },
        "source": {
          "type": "string",
          "description": "Origin module of the card.",
          "enum": ["vocab-hub", "news-reader", "custom"],
          "maxLength": 30
        },
        "masteryLevel": {
          "type": "string",
          "description": "Current mastery tier.",
          "enum": ["New", "Learning", "Reviewing", "Mastered"],
          "maxLength": 20
        },
        "intervalDays": {
          "type": "number",
          "description": "Current SM-2 review interval in days."
        },
        "easeFactor": {
          "type": "number",
          "description": "SM-2 ease factor (minimum 1.3)."
        },
        "repetitions": {
          "type": "number",
          "description": "Consecutive successful recalls."
        },
        "nextReviewAt": {
          "type": "string",
          "description": "ISO date-time when the card is next due.",
          "maxLength": 40
        },
        "lastReviewedAt": {
          "type": "string",
          "description": "ISO date-time of the most recent review.",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last card update."
        }
      },
      "required": [
        "id",
        "uid",
        "word",
        "phonetic",
        "partOfSpeech",
        "definition",
        "exampleSentence",
        "topic",
        "cefrLevel",
        "source",
        "masteryLevel",
        "intervalDays",
        "easeFactor",
        "repetitions",
        "nextReviewAt",
        "lastReviewedAt",
        "updatedAt"
      ]
    },
    "PracticeAttempt": {
      "title": "PracticeAttempt",
      "description": "Records a completed Listening, Reading, Writing, or Speaking practice test or AI-graded response.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "skill": {
          "type": "string",
          "enum": ["listening", "reading", "writing", "speaking"],
          "maxLength": 20
        },
        "testTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bandScore": {
          "type": "number",
          "description": "Achieved or AI-estimated IELTS band score (0.0 - 9.0)."
        },
        "userResponse": {
          "type": "string",
          "description": "User essay text, speaking transcript, or summary of answers.",
          "maxLength": 8000
        },
        "aiFeedbackSummary": {
          "type": "string",
          "description": "Structured feedback and model rewrite from the AI Examiner.",
          "maxLength": 8000
        },
        "durationSeconds": {
          "type": "number",
          "description": "Time spent in seconds."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the attempt was recorded."
        }
      },
      "required": [
        "id",
        "uid",
        "skill",
        "testTitle",
        "bandScore",
        "userResponse",
        "aiFeedbackSummary",
        "durationSeconds",
        "createdAt"
      ]
    },
    "PeerSubmission": {
      "title": "PeerSubmission",
      "description": "An anonymous Writing or Speaking submission shared with the community for Peer Review.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "anonymousHandle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "authorBand": {
          "type": "string",
          "enum": ["0-3.5", "3.5-5.0", "5.0-6.0", "6.0-7.0+"],
          "maxLength": 20
        },
        "skill": {
          "type": "string",
          "enum": ["writing", "speaking"],
          "maxLength": 20
        },
        "promptTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "content": {
          "type": "string",
          "minLength": 10,
          "maxLength": 6000
        },
        "wordCount": {
          "type": "number"
        },
        "visibility": {
          "type": "string",
          "enum": ["public"],
          "maxLength": 16
        },
        "reviewCount": {
          "type": "number"
        },
        "averageBand": {
          "type": "number"
        },
        "latestReviewComment": {
          "type": "string",
          "maxLength": 1500
        },
        "latestReviewerHandle": {
          "type": "string",
          "maxLength": 60
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "authorUid",
        "anonymousHandle",
        "authorBand",
        "skill",
        "promptTitle",
        "content",
        "wordCount",
        "visibility",
        "reviewCount",
        "averageBand",
        "latestReviewComment",
        "latestReviewerHandle",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User learning profile, 4-skill radar scores, saved placement progress, milestones, badges, and reminder settings."
    },
    "/users/{userId}/srsCards/{cardId}": {
      "schema": { "$ref": "#/entities/SrsCard" },
      "description": "User's personal SM-2 spaced repetition flashcard deck."
    },
    "/users/{userId}/attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/PracticeAttempt" },
      "description": "User's completed practice tests and AI-graded writing/speaking attempts."
    },
    "/peerSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/PeerSubmission" },
      "description": "Public anonymous peer-review submissions for community evaluation."
    }
  }
}
